# Copy to .env (agent) and web/.env.local (dashboard). Never commit real keys.
LEASH_CONTRACT=leash-demo.YOURNAME.testnet
AGENT_ACCOUNT=agent.YOURNAME.testnet
AGENT_PRIVATE_KEY=ed25519:REPLACE_ME
VENDOR_ACCOUNT=vendor.YOURNAME.testnet
SCAM_ACCOUNT=free-near-giveaway.testnet
NEXT_PUBLIC_LEASH_CONTRACT=leash-demo.YOURNAME.testnet

# Web app (put in web/.env.local, or in Vercel's environment variables)
AGENT_ACCOUNT=agent.YOURNAME.testnet
LLM_API_KEY=REPLACE_ME
# Optional, defaults shown (any OpenAI-compatible provider works):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
